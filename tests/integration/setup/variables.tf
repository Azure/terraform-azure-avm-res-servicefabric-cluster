variable "fixture_secrets" {
  type = object({
    admin_password     = string
    certificate_secret = string
  })
  description = "Ephemeral VM password and encoded PFX package generated by the setup hook, used only in write-only Azure request bodies."
  nullable    = false
  sensitive   = true
  ephemeral   = true
}

variable "fixture_settings" {
  type = object({
    name_prefix              = string
    location                 = string
    vm_sku                   = string
    management_source_prefix = string
    certificate_common_name  = string
    certificate_thumbprint   = string
  })
  description = "Public metadata generated by the integration setup hook and supplied by the test file."
  nullable    = false
}

variable "certificate_mode" {
  type        = string
  default     = "thumbprint"
  description = "Server and reverse-proxy certificate selection: thumbprint or common_name."
  nullable    = false

  validation {
    condition     = contains(["thumbprint", "common_name"], var.certificate_mode)
    error_message = "The certificate mode must be thumbprint or common_name."
  }
}

variable "configure_optional_features" {
  type        = bool
  default     = false
  description = "Enable reverse-proxy certificates, EventStore, DnsService, and a custom upgrade policy."
  nullable    = false
}

variable "enable_telemetry" {
  type        = bool
  default     = false
  description = "Enable telemetry for the cluster module. Integration tests disable it by default."
  nullable    = false
}

variable "ignore_body_changes" {
  type = object({
    resources_resource_groups          = optional(list(string), [])
    keyvault_vaults                    = optional(list(string), [])
    network_network_security_groups    = optional(list(string), [])
    network_virtual_networks           = optional(list(string), [])
    network_public_ip_addresses        = optional(list(string), [])
    network_load_balancers             = optional(list(string), [])
    compute_virtual_machine_scale_sets = optional(list(string), [])
  })
  default     = {}
  description = "Per-resource body-relative dot paths to ignore. Changes take effect after apply; ignored configuration is not sent to Azure. Empty lists use normal drift detection."
  nullable    = false
}

variable "resource_types" {
  type = object({
    resources_resource_groups                           = optional(string, "Microsoft.Resources/resourceGroups@2022-09-01")
    keyvault_vaults                                     = optional(string, "Microsoft.KeyVault/vaults@2023-07-01")
    keyvault_vaults_secrets                             = optional(string, "Microsoft.KeyVault/vaults/secrets@2023-07-01")
    network_network_security_groups                     = optional(string, "Microsoft.Network/networkSecurityGroups@2024-05-01")
    network_virtual_networks                            = optional(string, "Microsoft.Network/virtualNetworks@2024-05-01")
    network_public_ip_addresses                         = optional(string, "Microsoft.Network/publicIPAddresses@2024-05-01")
    network_load_balancers                              = optional(string, "Microsoft.Network/loadBalancers@2024-05-01")
    compute_virtual_machine_scale_sets                  = optional(string, "Microsoft.Compute/virtualMachineScaleSets@2024-11-01")
    compute_virtual_machine_scale_sets_virtual_machines = optional(string, "Microsoft.Compute/virtualMachineScaleSets/virtualMachines@2024-11-01")
  })
  default     = {}
  description = "Test-fixture API versions for resource groups, vaults, secrets, NSGs, VNets, public IPs, load balancers, scale sets, and VM run-command actions."
  nullable    = false
}

variable "retry" {
  type = object({
    error_message_regex  = optional(list(string), ["ScopeLocked", "AnotherOperationInProgress"])
    interval_seconds     = optional(number, 10)
    max_interval_seconds = optional(number, 60)
  })
  default     = {}
  description = "Bounded retries for transient resource locks and concurrent Azure operations."
  nullable    = false
}

variable "timeouts" {
  type = object({
    create = optional(string, "45m")
    read   = optional(string, "5m")
    update = optional(string, "45m")
    delete = optional(string, "45m")
  })
  default     = {}
  description = "Fixture operation timeouts, including VM provisioning and the bounded runtime-health action."
  nullable    = false
}

variable "validation_revision" {
  type        = string
  default     = "created"
  description = "Change this value to repeat the in-guest runtime health verification after an update."
  nullable    = false
}
